{
  // Oxc owns both linting and formatting (oxc.oxc-vscode). The extension does
  // not bundle the tools - it picks up the project-local `oxlint` and `oxfmt`
  // from node_modules, so `pnpm install` is enough. If the status item stays
  // grey after installing, run "Developer: Reload Window".
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,

  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports": "never"
  },

  "prettier.enable": false,

  // Vue template, a11y and <style> diagnostics come from Vize (ubugeeei.vize),
  // which is the half oxlint cannot do: all 46 of its vue/* rules are <script>
  // rules, because oxlint has no Vue template parser.
  "vize.lint.enable": true,
  // Formatting stays with oxfmt so the two never fight over the same buffer.
  // Mirrors `lsp.formatting: false` in vize.config.json.
  "vize.formatting.enable": false,
  // Types stay with Volar + `pnpm typecheck` (vue-tsc). Vize's own checker is
  // still maturing upstream and would only double up the diagnostics.
  "vize.typecheck.enable": false,

  "cSpell.words": [
    "degit",
    "Icones",
    "iconify",
    "oxfmt",
    "oxlint",
    "patina",
    "pinia",
    "ubugeeei",
    "unocss",
    "unplugin",
    "Vite",
    "Vitest",
    "vize",
    "vueuse"
  ]
}
